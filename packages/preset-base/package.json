{
  "name": "@cieloazul310/digital-go-pandacss-plugin",
  "version": "0.2.3",
  "license": "MIT",
  "homepage": "https://github.com/cieloazul310/digital-go-design-system-with-panda",
  "author": {
    "name": "cieloazul310",
    "url": "https://cieloazul310.github.io"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cieloazul310/digital-go-design-system-with-panda.git",
    "directory": "packages/preset-base"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "types": "./dist/index.d.ts",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "npm run build -- --watch",
    "eslint": "eslint src --fix",
    "format": "prettier --parser typescript --write ."
  },
  "dependencies": {
    "@cieloazul310/digital-go-pandacss-utils": "^0.2.3",
    "@digital-go-jp/design-tokens": "^1.1.1"
  },
  "devDependencies": {
    "@pandacss/dev": "^1.4.2",
    "@pandacss/preset-panda": "^1.4.2",
    "@repo/eslint-config": "^0.2.3",
    "@repo/typescript-config": "^0.2.3",
    "eslint": "^9.37.0",
    "polished": "^4.3.1",
    "tsdown": "^0.20.1",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@pandacss/dev": ">=1.0.1",
    "@pandacss/preset-panda": ">=1.0.0"
  },
  "lint-staged": {
    "**/*.{js,mjs,cjs,tsx,ts,tsx}": [
      "eslint --fix",
      "prettier --parser typescript --write"
    ]
  }
}