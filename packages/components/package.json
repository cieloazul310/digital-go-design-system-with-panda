{
  "name": "@cieloazul310/digital-go-react-components",
  "version": "0.0.0",
  "license": "MIT",
  "homepage": "https://github.com/cieloazul310/digital-go-design-system-with-panda",
  "author": {
    "name": "cieloazul310",
    "url": "https://cieloazul310.github.io"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cieloazul310/digital-go-design-system-with-panda.git",
    "directory": "packages/components"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "source": "./src/index.tsx",
      "types": "./dist/index.d.ts",
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": "./dist/index.js"
    },
    "./*": {
      "source": "./src/*/index.tsx",
      "types": "./dist/*/index.d.ts",
      "import": {
        "types": "./dist/*/index.d.mts",
        "default": "./dist/*/index.mjs"
      },
      "require": "./dist/*/index.js"
    },
    "./form/*": {
      "source": "./src/form/*.tsx",
      "types": "./dist/form/*.d.ts",
      "import": {
        "types": "./dist/form/*.d.mts",
        "default": "./dist/form/*.mjs"
      },
      "require": "./dist/form/*.js"
    }
  },
  "scripts": {
    "panda": "panda codegen",
    "prebuild": "npm run panda",
    "build": "tsup && tsc",
    "dev": "npm run build -- --watch",
    "eslint": "eslint src --fix",
    "format": "prettier --parser typescript --write ."
  },
  "dependencies": {
    "@cieloazul310/digital-go-pandacss-preset": "^0.0.0"
  },
  "devDependencies": {
    "@ark-ui/react": "^5.13.0",
    "@pandacss/dev": "^0.53.7",
    "@repo/eslint-config": "^0.0.0",
    "@repo/typescript-config": "^0.0.0",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.6",
    "eslint": "^9.28.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsup": "8.5.0",
    "typescript": "5.8.3"
  },
  "peerDependencies": {
    "@ark-ui/react": "^5.0.0",
    "@cieloazul310/styled-system": "^0.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "lint-staged": {
    "**/*.{js,mjs,cjs,tsx,ts,tsx}": [
      "eslint --fix",
      "prettier --parser typescript --write"
    ]
  }
}