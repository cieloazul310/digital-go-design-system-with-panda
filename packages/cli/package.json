  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cieloazul310/digital-go-design-system-with-panda.git",
    "directory": "packages/cli"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "files": [
    "bin",
    "public"
  ],
  "bin": {
    "digital-go-pandacss": "./bin/index.cjs"
  },
  "scripts": {
    "prebuild": "tsx ../../scripts/generate-catalogue.ts",
    "build": "tsdown",
    "dev": "npm run build -- --watch",
    "eslint": "eslint src --fix",
    "format": "prettier --parser typescript --write ."
  },
  "dependencies": {
    "commander": "^15.0.0",
    "simple-git": "^4.0.2"
  },
  "devDependencies": {
    "@repo/eslint-config": "^0.4.0",
    "@repo/typescript-config": "^0.4.0",
    "eslint": "^10.11.0",
    "execa": "^10.0.1",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.15",
    "typescript": "^6"
  },
  "lint-staged": {
    "**/*.{js,mjs,cjs,tsx,ts,tsx}": [
      "eslint --fix",
      "prettier --parser typescript --write"
    ]
  }
}