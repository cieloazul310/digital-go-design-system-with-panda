    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react-swc": "^3.10.1",
    "eslint": "^9.32.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.6",
