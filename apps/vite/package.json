{
  "name": "app",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "prebuild": "panda codegen",
    "panda": "panda codegen",
    "start": "vite",
    "build": "tsc && vite build",
    "snippet": "node ../../packages/cli/bin/index.cjs",
