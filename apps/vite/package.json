  "dependencies": {
    "@ark-ui/react": "^5.36.2",
    "lucide-react": "^0.545.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@cieloazul310/digital-go-pandacss-preset": "^0.3.0",
    "@pandacss/dev": "^1.11.1",
    "@repo/eslint-config": "^0.3.0",
    "@repo/typescript-config": "^0.3.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react-swc": "^4.1.0",
    "eslint": "^9.37.0",
    "typescript": "^6.0.3",
    "vite": "^7.1.11",
    "vite-tsconfig-paths": "^5.1.4"
  },
  "lint-staged": {
    "**/*.{js,mjs,cjs,tsx,ts,tsx}": [
      "eslint --fix",
      "prettier --parser typescript --write"
