{
  "name": "digital-go-design-system-with-panda",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": ">=26",
    "npm": ">=11"
  },
  "packageManager": "npm@12.2.0",
  "workspaces": [
    "packages/*",
    "apps/*",
    "components"
  ],
  "description": "デザイン庁デザインシステムをPanda CSSで実装するリポジトリ",
  "author": "@cieloazul310",
  "license": "ISC",
  "scripts": {
    "prepare": "git config --local core.hooksPath .githooks",
    "turbo": "turbo",
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "build:package": "turbo run build --filter='./packages/*' --filter='./components'",
    "build:docs": "tsx ./scripts/update-readme.ts",
    "changeset": "changeset",
    "publish-packages": "npm run build:package && changeset version && changeset publish",
    "lint-staged": "lint-staged",
    "test": "vitest"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@typescript-eslint/parser": "^8.71.0",
    "@types/node": "^26",
    "change-case": "^5.4.4",
    "eslint": "^10.11.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.15",
    "turbo": "^2.11.6",
    "typescript": "^6",
    "vitest": "^5.0.3",
    "yaml": "^2.9.1"
  },
  "lint-staged": {
    "**/*.{js,mjs,cjs,tsx,ts,tsx}": [
      "prettier --parser typescript --write"
    ]
  }
}