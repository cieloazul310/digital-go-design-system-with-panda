{
  "name": "digital-go-design-system-with-panda",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": ">=26",
    "npm": ">=11"
  },
  "packageManager": "npm@11.13.0",
  "workspaces": [
    "packages/*",
    "apps/*",
    "components"
  ],
  "description": "デザイン庁デザインシステムをPanda CSSで実装するリポジトリ",
  "author": "@cieloazul310",
  "license": "ISC",
  "scripts": {
    "prepare": "git config --local core.hooksPath .githooks",
    "turbo": "turbo",
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "build:package": "turbo run build --filter='./packages/*' --filter='./components'",
    "build:docs": "tsx ./scripts/update-readme.ts",
    "changeset": "changeset",
    "publish-packages": "npm run build:package && changeset version && changeset publish",
    "lint-staged": "lint-staged",
    "test": "vitest"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@types/node": "^24",
    "change-case": "^5.4.4",
    "eslint": "^9.37.0",
    "lint-staged": "^17.0.5",
    "prettier": "^3.8.3",
    "tsup": "^8.5.1",
    "tsx": "^4.22.2",
    "turbo": "^2.9.14",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6",
    "yaml": "^2.9.0"
  },
  "lint-staged": {
    "**/*.{js,mjs,cjs,tsx,ts,tsx}": [
      "prettier --parser typescript --write"
    ]
  }
}
